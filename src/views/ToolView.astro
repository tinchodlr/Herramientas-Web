---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolRenderer from '../components/ToolRenderer.astro';
import { getIcon } from '../components/icons';
import { SITE_NAME, type Lang } from '../config';
import { getCategory, toolsByCategory, type Tool } from '../data/tools';
import { homePath, toolPath, useT } from '../i18n/ui';
import { ChevronRight, Gift, ShieldCheck } from 'lucide-preact';

interface Props {
  tool: Tool;
  lang: Lang;
}

const { tool, lang } = Astro.props;
const t = useT(lang);
const category = getCategory(tool.category);
const Icon = getIcon(tool.icon);
const related = toolsByCategory(tool.category).filter((x) => x.id !== tool.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name[lang],
  description: tool.description[lang],
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base
  lang={lang}
  title={`${tool.name[lang]} ${t('meta.toolSuffix')} · ${SITE_NAME[lang]}`}
  description={tool.description[lang]}
  alternates={{ es: toolPath(tool, 'es'), en: toolPath(tool, 'en') }}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container tool-page" data-cat={tool.category}>
    <nav class="breadcrumb small" aria-label="breadcrumb">
      <a href={homePath(lang)}>{t('nav.home')}</a>
      <ChevronRight aria-hidden="true" />
      <a href={`${homePath(lang)}#${category.anchor[lang]}`}>{category.name[lang]}</a>
    </nav>

    <header class="tool-header">
      <span class="icon-tile" style="--size:52px"><Icon aria-hidden="true" /></span>
      <div class="tool-header-text">
        <h1>{tool.name[lang]}</h1>
        <p class="tool-desc">{tool.description[lang]}</p>
        <div class="btn-row">
          <span class="badge badge-success"><ShieldCheck aria-hidden="true" />{t('tool.private')}</span>
          <span class="badge"><Gift aria-hidden="true" />{t('tool.free')}</span>
        </div>
      </div>
    </header>

    <div class="tool-root">
      <ToolRenderer id={tool.id} lang={lang} />
    </div>

    <section class="howto">
      <h2>{t('tool.howTo')}</h2>
      <ol>
        {tool.steps[lang].map((step, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>

    {related.length > 0 && (
      <section class="related">
        <h2>{t('tool.related')} {category.name[lang].toLowerCase()}</h2>
        <div class="related-grid">
          {related.map((r) => <ToolCard tool={r} lang={lang} />)}
        </div>
        <a class="btn btn-sm" href={homePath(lang)}>{t('tool.backHome')}</a>
      </section>
    )}
  </div>
</Base>

<style>
  .tool-page {
    padding-top: 22px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-3);
    margin-bottom: 22px;
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .breadcrumb :global(svg) {
    width: 14px;
    height: 14px;
  }

  .tool-header {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    margin-bottom: 28px;
  }

  .tool-header-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .tool-header h1 {
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 740;
    letter-spacing: -0.03em;
  }

  .tool-desc {
    color: var(--text-2);
    font-size: 16px;
    max-width: 76ch;
  }

  .tool-root {
    min-height: 200px;
  }

  .howto {
    margin-top: 56px;
  }

  .howto h2,
  .related h2 {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .howto ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .howto li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    font-size: 14.5px;
    color: var(--text-2);
  }

  .step-num {
    width: 26px;
    height: 26px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    color: var(--cat);
    background: color-mix(in srgb, var(--cat) 13%, transparent);
  }

  .related {
    margin-top: 48px;
  }

  .related-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    margin-bottom: 18px;
  }

  @media (max-width: 560px) {
    .tool-header {
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
